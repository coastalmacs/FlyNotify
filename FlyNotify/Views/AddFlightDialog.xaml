<Window x:Class="FlyNotify.AddFlightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlyNotify"
        mc:Ignorable="d"
        Title="Add Flight Profile" Height="450" Width="800">

    <Window.Resources>
        <!-- Corporate Identity Colors -->
        <SolidColorBrush x:Key="QantasRedBrush" Color="#E02020"/>
        <SolidColorBrush x:Key="JetCharcoalBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="SlateGrayBrush" Color="#54565A"/>
        <SolidColorBrush x:Key="LightGrayBorderBrush" Color="#D1D1D1"/>

        <!-- Form Styling Rules -->
        <Style x:Key="FormLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource SlateGrayBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource LightGrayBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource QantasRedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource LightGrayBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource QantasRedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource QantasRedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B01818"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Dialog Header Banner Area -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="NEW FLIGHT PROFILE" 
                       FontSize="16" 
                       FontWeight="Black" 
                       Foreground="{StaticResource JetCharcoalBrush}"/>
            <TextBlock Text="Configure targeted monitoring criteria for QFF award seat tracking." 
                       FontSize="11" 
                       Foreground="{StaticResource SlateGrayBrush}"
                       Margin="0,4,0,0"/>
            <Separator Background="{StaticResource LightGrayBorderBrush}" Margin="0,15,0,0"/>
        </StackPanel>

        <!-- Primary Structured Entry Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Departure Airport (IATA)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TxtDeparture" Style="{StaticResource FormTextBoxStyle}" MaxLength="3" CharacterCasing="Upper"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Arrival Airport (IATA / Region)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TxtArrival" Style="{StaticResource FormTextBoxStyle}" MaxLength="6" CharacterCasing="Upper"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Travel Date" Style="{StaticResource FormLabelStyle}"/>
                        <DatePicker x:Name="DpTravelDate" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Flight Number" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TxtFlightNumber" Style="{StaticResource FormTextBoxStyle}" MaxLength="6" CharacterCasing="Upper"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Departure Time (HH:MM)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TxtDepartureTime" Style="{StaticResource FormTextBoxStyle}" MaxLength="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Arrival Time (HH:MM)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TxtArrivalTime" Style="{StaticResource FormTextBoxStyle}" MaxLength="5"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Cabin Class" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox x:Name="CbCabinClass" Style="{StaticResource FormComboBoxStyle}" SelectedIndex="2">
                            <ComboBoxItem Content="Economy"/>
                            <ComboBoxItem Content="Premium Economy"/>
                            <ComboBoxItem Content="Business"/>
                            <ComboBoxItem Content="First"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Passengers" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox x:Name="CbPassengers" Style="{StaticResource FormComboBoxStyle}" SelectedIndex="0">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="6"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Command Execution Control Actions Strip -->
        <Border Grid.Row="2" 
                BorderBrush="{StaticResource LightGrayBorderBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" 
                        Background="Transparent" 
                        Foreground="{StaticResource SlateGrayBrush}"
                        FontWeight="SemiBold"
                        Margin="0,0,10,0"
                        Padding="15,10"
                        Click="CancelButton_Click"/>

                <Button Content="Save Profile" 
                        Style="{StaticResource ActionButtonStyle}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
