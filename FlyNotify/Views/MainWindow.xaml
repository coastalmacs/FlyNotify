<Window
    x:Class="FlyNotify.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FlyNotify"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title=""
    Width="1024"
    Height="768"
    Icon="/Assets/app.ico"
    mc:Ignorable="d">

    <Window.Resources>
        <SolidColorBrush x:Key="QantasRedBrush" Color="#E02020" />
        <SolidColorBrush x:Key="JetCharcoalBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="SlateGrayBrush" Color="#54565A" />
        <SolidColorBrush x:Key="LightGrayBorderBrush" Color="#D1D1D1" />
        <SolidColorBrush x:Key="LinkBlueBrush" Color="#0066CC" />
        <SolidColorBrush x:Key="LinkGrayBrush" Color="#54565A" />
        <Style x:Key="BrandButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource QantasRedBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SlateGrayBrush}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3D3E40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionLinkStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LinkGrayBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5,0" />
        </Style>

        <ContextMenu x:Key="RowContextMenu">
            <MenuItem Click="EditProfile_Click" Header="Edit Profile" />
            <MenuItem Click="DeleteProfile_Click" Header="Delete Profile" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="20,15"
            Background="{StaticResource JetCharcoalBrush}">
            <Grid>
                <TextBlock
                    FontSize="20"
                    FontWeight="Black"
                    Foreground="White"
                    Text="FLYNOTIFY" />
                <TextBlock
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#A0A0A0"
                    Text="QFF Award Seat Analyzer" />
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Padding="20,12"
            Background="White"
            BorderBrush="{StaticResource LightGrayBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <Button
                        Margin="0,0,10,0"
                        Click="AddFlightButton_Click"
                        Content="Add Flight Profile"
                        Style="{StaticResource BrandButtonStyle}" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        x:Name="ManualBatchBtn"
                        Background="{StaticResource QantasRedBrush}"
                        Click="ManualBatchButton_Click"
                        Content="Manual Batch Query"
                        Style="{StaticResource BrandButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid
            x:Name="FlightDataGrid"
            Grid.Row="2"
            Margin="20"
            AutoGenerateColumns="False"
            Background="White"
            BorderBrush="{StaticResource LightGrayBorderBrush}"
            CanUserAddRows="False"
            CanUserSortColumns="True"
            FontSize="13"
            GridLinesVisibility="Horizontal"
            HorizontalGridLinesBrush="#E5E5E5"
            IsReadOnly="True"
            PreviewKeyDown="FlightDataGrid_PreviewKeyDown"
            RowHeaderWidth="0">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F2F2F2" />
                    <Setter Property="Foreground" Value="{StaticResource JetCharcoalBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Padding" Value="10,12" />
                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                    <Setter Property="BorderBrush" Value="{StaticResource LightGrayBorderBrush}" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Padding" Value="0,8" />
                    <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
                    <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F9F9F9" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="25*"
                    Binding="{Binding FullScheduleDisplay}"
                    Header="Date" />

                <DataGridTextColumn
                    Width="10*"
                    Binding="{Binding FlightNumber}"
                    Header="Flight" />

                <DataGridTextColumn
                    Width="10*"
                    Binding="{Binding DepartureAirport}"
                    Header="Dep" />
                <DataGridTextColumn
                    Width="10*"
                    Binding="{Binding ArrivalAirport}"
                    Header="Arr" />

                <DataGridTextColumn
                    Width="10*"
                    Binding="{Binding Duration}"
                    Header="Dur" />

                <DataGridTextColumn
                    Width="8*"
                    Binding="{Binding CabinClass}"
                    Header="Class" />

                <DataGridTextColumn
                    Width="8*"
                    Binding="{Binding PassengerCount}"
                    Header="Pax" />

                <DataGridTextColumn
                    Width="10*"
                    Binding="{Binding AvailabilityStatus}"
                    Header="Status" />
                <DataGridTextColumn
                    Width="20*"
                    Binding="{Binding LastCheckedDisplay}"
                    Header="Checked" />

                <DataGridTemplateColumn Width="25*" Header="Links">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    MouseLeftButtonDown="QantasLink_MouseLeftButtonDown"
                                    Style="{StaticResource ActionLinkStyle}"
                                    Text="Qantas" />
                                <TextBlock
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource LightGrayBorderBrush}"
                                    Text="|" />
                                <TextBlock
                                    MouseLeftButtonDown="ExpertFlyerLink_MouseLeftButtonDown"
                                    Style="{StaticResource ActionLinkStyle}"
                                    Text="ExpertFlyer" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar
            Grid.Row="3"
            Padding="20,6"
            Background="#E9E9E9"
            BorderBrush="{StaticResource LightGrayBorderBrush}"
            BorderThickness="0,1,0,0">
            <StatusBarItem HorizontalAlignment="Left">
                <TextBlock
                    x:Name="StatusMessageText"
                    FontSize="11"
                    Foreground="{StaticResource SlateGrayBrush}"
                    Text="System Ready. Daily batch queries automated for 10:00 AM." />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock
                    x:Name="EngineSchedulerText"
                    FontSize="11"
                    Foreground="{StaticResource SlateGrayBrush}"
                    Text="Scheduler Status: Idle" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
