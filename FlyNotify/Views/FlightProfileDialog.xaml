<Window
    x:Class="FlyNotify.Views.FlightProfileDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit Flight Profile"
    Width="640"
    Height="480"
    Background="#F9F9F9"
    FocusManager.FocusedElement="{Binding ElementName=TxtDeparture}"
    FontFamily="Segoe UI"
    FontSize="13"
    Icon="/Assets/app.ico"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="QantasRedBrush" Color="#E02020" />
        <SolidColorBrush x:Key="JetCharcoalBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="SlateGrayBrush" Color="#54565A" />
        <SolidColorBrush x:Key="LightGrayBorderBrush" Color="#D1D1D1" />
        <SolidColorBrush x:Key="LinkGrayBrush" Color="#54565A" />

        <Style x:Key="FormLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource SlateGrayBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{StaticResource LightGrayBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource QantasRedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource QantasRedBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource LinkGrayBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock
                FontSize="16"
                FontWeight="Black"
                Foreground="{StaticResource JetCharcoalBrush}"
                Text="EDIT FLIGHT PROFILE" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="11"
                Foreground="{StaticResource SlateGrayBrush}"
                Text="Configure targeted monitoring criteria for QFF award seat tracking." />
            <Separator Margin="0,15,0,0" Background="{StaticResource LightGrayBorderBrush}" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,0,15"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Departure Airport (IATA/Region code)" Style="{StaticResource FormLabelStyle}" />
                        <TextBox
                            x:Name="TxtDeparture"
                            CharacterCasing="Upper"
                            MaxLength="3"
                            Style="{StaticResource FormTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Arrival Airport (IATA/Region code or ALL)" Style="{StaticResource FormLabelStyle}" />
                        <TextBox
                            x:Name="TxtArrival"
                            CharacterCasing="Upper"
                            MaxLength="6"
                            Style="{StaticResource FormTextBoxStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Travel Start Date" Style="{StaticResource FormLabelStyle}" />
                        <DatePicker
                            x:Name="DpTravelStartDate"
                            Padding="5"
                            HorizontalAlignment="Stretch"
                            SelectedDateChanged="DpTravelStartDate_SelectedDateChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Travel End Date" Style="{StaticResource FormLabelStyle}" />
                        <DatePicker
                            x:Name="DpTravelEndDate"
                            Padding="5"
                            HorizontalAlignment="Stretch"
                            SelectedDateChanged="DpTravelEndDate_SelectedDateChanged" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,15,0,0">
                    <StackPanel>
                        <Label Content="Cabin Class (Select one or more)" Style="{StaticResource FormLabelStyle}" />
                        <WrapPanel Margin="0,5,0,0" Orientation="Horizontal">
                            <CheckBox
                                x:Name="ChkEconomy"
                                Margin="0,0,15,5"
                                Content="Economy" />
                            <CheckBox
                                x:Name="ChkPremium"
                                Margin="0,0,15,5"
                                Content="Premium Economy" />
                            <CheckBox
                                x:Name="ChkBusiness"
                                Margin="0,0,15,5"
                                Content="Business" />
                            <CheckBox
                                x:Name="ChkFirst"
                                Margin="0,0,15,5"
                                Content="First"
                                IsChecked="True" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,15,0,0">
                    <StackPanel>
                        <Label Content="Passengers" Style="{StaticResource FormLabelStyle}" />
                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                            <RadioButton
                                x:Name="RbPax1"
                                Margin="0,0,20,0"
                                Content="1"
                                GroupName="Passengers"
                                IsChecked="True" />
                            <RadioButton
                                x:Name="RbPax2"
                                Margin="0,0,20,0"
                                Content="2"
                                GroupName="Passengers" />
                            <RadioButton
                                x:Name="RbPax3"
                                Margin="0,0,20,0"
                                Content="3"
                                GroupName="Passengers" />
                            <RadioButton
                                x:Name="RbPax4"
                                Margin="0,0,20,0"
                                Content="4"
                                GroupName="Passengers" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="0,15,0,0"
            BorderBrush="{StaticResource LightGrayBorderBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Margin="0,0,10,0"
                    Padding="15,10"
                    Background="Transparent"
                    Click="CancelButton_Click"
                    Content="Cancel"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SlateGrayBrush}" />

                <Button
                    Click="SaveButton_Click"
                    Content="Save Profile"
                    Style="{StaticResource ActionButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
