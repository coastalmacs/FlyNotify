<Window x:Class="FlyNotify.Views.FlightProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Flight Profile" 
        Height="480" 
        Width="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F9F9F9"
        FontFamily="Segoe UI"
        FontSize="13"
        Icon="/Assets/app.ico"
        FocusManager.FocusedElement="{Binding ElementName=TxtDeparture}"
        >

    <Window.Resources>
        <SolidColorBrush x:Key="QantasRedBrush" Color="#E02020"/>
        <SolidColorBrush x:Key="JetCharcoalBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="SlateGrayBrush" Color="#54565A"/>
        <SolidColorBrush x:Key="LightGrayBorderBrush" Color="#D1D1D1"/>
        <SolidColorBrush x:Key="LinkGrayBrush" Color="#54565A"/>

        <Style x:Key="FormLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource SlateGrayBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource LightGrayBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource QantasRedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource QantasRedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource LinkGrayBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="EDIT FLIGHT PROFILE" 
                       FontSize="16" 
                       FontWeight="Black" 
                       Foreground="{StaticResource JetCharcoalBrush}"/>
            <TextBlock Text="Configure targeted monitoring criteria for QFF award seat tracking." 
                       FontSize="11" 
                       Foreground="{StaticResource SlateGrayBrush}"
                       Margin="0,4,0,0"/>
            <Separator Background="{StaticResource LightGrayBorderBrush}" Margin="0,15,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Departure Airport (IATA/Region)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TxtDeparture" Style="{StaticResource FormTextBoxStyle}" MaxLength="3" CharacterCasing="Upper"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Arrival Airport (IATA/Region)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TxtArrival" Style="{StaticResource FormTextBoxStyle}" MaxLength="6" CharacterCasing="Upper"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Travel Start Date" Style="{StaticResource FormLabelStyle}"/>
                        <DatePicker x:Name="DpTravelStartDate" Padding="5" HorizontalAlignment="Stretch" SelectedDateChanged="DpTravelStartDate_SelectedDateChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Travel End Date" Style="{StaticResource FormLabelStyle}"/>
                        <DatePicker x:Name="DpTravelEndDate" Padding="5" HorizontalAlignment="Stretch" SelectedDateChanged="DpTravelEndDate_SelectedDateChanged" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,15,0,0">
                    <StackPanel>
                        <Label Content="Cabin Class (Select one or more)" Style="{StaticResource FormLabelStyle}"/>
                        <WrapPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <CheckBox x:Name="ChkEconomy" Content="Economy" Margin="0,0,15,5"/>
                            <CheckBox x:Name="ChkPremium" Content="Premium Economy" Margin="0,0,15,5"/>
                            <CheckBox x:Name="ChkBusiness" Content="Business" Margin="0,0,15,5" />
                            <CheckBox x:Name="ChkFirst" Content="First" Margin="0,0,15,5" IsChecked="True"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,15,0,0">
                    <StackPanel>
                        <Label Content="Passengers" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <RadioButton x:Name="RbPax1" Content="1" GroupName="Passengers" Margin="0,0,20,0" IsChecked="True"/>
                            <RadioButton x:Name="RbPax2" Content="2" GroupName="Passengers" Margin="0,0,20,0"/>
                            <RadioButton x:Name="RbPax3" Content="3" GroupName="Passengers" Margin="0,0,20,0"/>
                            <RadioButton x:Name="RbPax4" Content="4" GroupName="Passengers" Margin="0,0,20,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" 
                BorderBrush="{StaticResource LightGrayBorderBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" 
                        Background="Transparent" 
                        Foreground="{StaticResource SlateGrayBrush}"
                        FontWeight="SemiBold"
                        Margin="0,0,10,0"
                        Padding="15,10"
                        Click="CancelButton_Click"/>

                <Button Content="Save Profile" 
                        Style="{StaticResource ActionButtonStyle}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
